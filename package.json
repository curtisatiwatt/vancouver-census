{
  "name": "vancouver-census",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Metro Vancouver 2021 Census population, population groups and household income atlas",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && node scripts/validate-data.mjs",
    "prepare:data": "python3 scripts/build-data.py",
    "prepare:geography": "python3 scripts/build-geography.py"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "vite": "^8.0.0"
  }
}
